resolver 127.0.0.11 valid=5s ipv6=off;

# Resolve again when Compose recreates the API container.
upstream telegram_intake {
    zone telegram_intake 64k;
    server webhook_service:8000 resolve;
}

limit_conn_zone $server_name zone=telegram_demo:64k;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    access_log off;
    # Request targets and malformed headers may contain credentials.
    error_log /dev/null;
    client_max_body_size 1m;
    client_body_buffer_size 1m;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 5s;
    keepalive_timeout 0;
    limit_conn telegram_demo 16;

    location = /webhooks/telegram/${TELEGRAM_DEMO_BOT_ID} {
        # Reject query strings and encoded/normalized aliases as well.
        if ($request_uri != "/webhooks/telegram/${TELEGRAM_DEMO_BOT_ID}") { return 404; }
        if ($request_method != POST) { return 405; }
        proxy_pass http://telegram_intake;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_set_header Host webhook_service;
        proxy_set_header Connection "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Content-Encoding $http_content_encoding;
        proxy_set_header X-Telegram-Bot-Api-Secret-Token $http_x_telegram_bot_api_secret_token;
        proxy_connect_timeout 3s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        # The API owns authentication; never retry an admitted update here.
        proxy_next_upstream off;
    }

    location / { return 404; }
}
