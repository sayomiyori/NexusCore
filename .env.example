# Use URL-safe local credentials (letters, digits, hyphen, underscore).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Required: URL-safe per-service PostgreSQL role passwords and Redis password.
AUTH_DB_PASSWORD=
WEBHOOK_DB_PASSWORD=
AGENT_DB_PASSWORD=
REDIS_PASSWORD=
# Optional for startup; required for real Groq generation.
GROQ_API_KEY=
# Direct provider probes passed; current Compose forwards only GROQ_API_KEY.
# These placeholders do not activate additional AgentHub adapters.
GEMINI_API_KEY=
OPENROUTER_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Required: generate independent random values of at least 32 bytes.
AUTH_SECRET_KEY=
WEBHOOK_SECRET_KEY=

# Platform registration, intake and AI/answer delivery are opt-in.
PLATFORM_BOTS_ENABLED=false
BOT_CREDENTIALS_KEY=
# Optional: leave unset until an independent service key is generated.
# AUTHFORTRESS_WEBHOOK_SERVICE_KEY=
WEBHOOK_AGENT_CONTEXT_KEY=
RATE_LIMIT_BOT_REGISTER=10
PLATFORM_TELEGRAM_ENABLED=false
TELEGRAM_WEBHOOK_ORIGIN=
WEBHOOK_AGENT_INGRESS_KEY=
PLATFORM_PUBLICATION_MAX_ATTEMPTS=10
TELEGRAM_AI_ENABLED=false
PLATFORM_READ_ENABLED=false
# Root Compose requires a tenant-scoped AgentHub revision; the API fails closed without it.
PLATFORM_TENANT_ENABLED=true
TELEGRAM_AI_MODEL=openai/gpt-oss-20b
# Standalone AgentHub model; independent of the guarded Telegram pipeline.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
TELEGRAM_REPLIES_ENABLED=false
AGENT_WEBHOOK_REPLY_KEY=

# Only read by the optional docker-compose.telegram-demo.yml overlay.
# The local registered bot UUID, not its numeric Telegram identity or token.
TELEGRAM_DEMO_BOT_ID=

# Optional metadata relay only; not loaded or forwarded by the root Compose.
# Select auth/webhook/agent sources with explicit CLI origins, not these settings.
# Export a short-lived tenant owner access JWT to this process environment.
# Never pass the token as a CLI argument or commit an actual value.
NEXUS_EVENTS_TOKEN=
