# Use URL-safe local credentials (letters, digits, hyphen, underscore).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Optional for startup; required for real Groq generation.
GROQ_API_KEY=
AUTH_SECRET_KEY=replace_with_random_secret_at_least_32_characters
WEBHOOK_SECRET_KEY=replace_with_random_secret_at_least_32_characters

# Tenant bot registration is opt-in; webhook/AI/answer admission remains pending.
PLATFORM_BOTS_ENABLED=false
BOT_CREDENTIALS_KEY=
# Optional: leave unset until an independent service key is generated.
# AUTHFORTRESS_WEBHOOK_SERVICE_KEY=
WEBHOOK_AGENT_CONTEXT_KEY=
RATE_LIMIT_BOT_REGISTER=10
