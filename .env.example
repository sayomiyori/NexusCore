# Use URL-safe local credentials (letters, digits, hyphen, underscore).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Optional for startup; required for real Groq generation.
GROQ_API_KEY=
AUTH_SECRET_KEY=replace_with_random_secret_at_least_32_characters
WEBHOOK_SECRET_KEY=replace_with_random_secret_at_least_32_characters
